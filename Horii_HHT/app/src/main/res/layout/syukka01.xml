<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Upper bar -->
    <View
        android:id="@+id/view"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="#a4a8d4"
        app:layout_constraintEnd_toEndOf="parent"
        android:focusable="false"
        android:focusableInTouchMode="false"

    app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Text inside upper bar -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/sawarabi_gothic"
        android:text="検品単位選択"
        android:textColor="#000000"
        android:textSize="40sp"
        app:layout_constraintBottom_toBottomOf="@+id/view"
        app:layout_constraintStart_toStartOf="@+id/view"
        app:layout_constraintTop_toTopOf="@+id/view" />

    <!-- Lower bar -->
    <View
        android:id="@+id/view2"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="#a1d8e2"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Text inside lower bar -->
    <Button
        android:id="@+id/back_btn"
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/clear_button_bg"
        android:fontFamily="@font/sawarabi_gothic"
        android:gravity="end|center_vertical"
        android:padding="0dp"
        android:text="F4:戻る"
        android:textColor="#000000"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/view2"
        app:layout_constraintTop_toTopOf="@+id/view2"
        app:layout_constraintVertical_bias="0.0"
        android:focusable="false"
        android:focusableInTouchMode="false"/>



    <!-- Buttons -->
    <TextView
        android:id="@+id/nyukabtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"

        android:focusable="false"
        android:focusableInTouchMode="false"
        android:fontFamily="@font/sawarabi_gothic"
        android:text="検品単位を選択してください。"
        android:textColor="@color/black"
        android:textSize="28sp"
        app:layout_constraintBottom_toTopOf="@+id/syukkabtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view" />

    <Button
        android:id="@+id/syukkabtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/tannibutton"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:fontFamily="@font/sawarabi_gothic"
        android:text="F1:ケース"
        android:textColor="@color/black"
        android:textSize="40sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/tanaoroshibtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nyukabtn" />

    <Button
        android:id="@+id/tanaoroshibtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/tannibutton"
        android:fontFamily="@font/sawarabi_gothic"
        android:text="F2:バラ"
        android:textColor="@color/black"
        android:textSize="40sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/view2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/syukkabtn"
        android:focusable="false"
        android:focusableInTouchMode="false"/>



</androidx.constraintlayout.widget.ConstraintLayout>